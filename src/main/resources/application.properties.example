spring.application.name=sbs

# Active Profile (dev or prod)
spring.profiles.active=dev

server.port=8080

# JPA Common Settings
spring.jpa.properties.hibernate.default_batch_fetch_size=1000
spring.jpa.properties.hibernate.use_sql_comments=true
logging.level.org.hibernate.type.descriptor.sql=trace

worldId=1

# Heartbeat Settings
heartbeat.throttle-seconds=30
heartbeat.resume-threshold-seconds=60

# Log file
logging.file.name=logs/app.log

# Jackson Settings
spring.jackson.serialization.fail-on-empty-beans=false
spring.jackson.default-property-inclusion=non_null

# JWT Settings — 환경변수 JWT_SECRET 필수
jwt.secret=${JWT_SECRET}
# 1 hour
jwt.access-token-validity-in-seconds=3600
# 30 days
jwt.refresh-token-validity-in-seconds=2592000

# DB test data
test.data.count=3
test.data.pvp.enabled=true
test.data.pvp.base-score=1000
test.data.pvp.deviation=100
test.data.zone.enabled=true
test.data.zone.base=5-5
test.data.zone.deviation=5

# Ranking Sync Settings
ranking.pvp.sync.rate-minutes=60
ranking.zone.sync.rate-minutes=60

# Redis Settings
spring.data.redis.host=localhost
spring.data.redis.port=6379

# Google OAuth Settings
google.client-id=YOUR_GOOGLE_CLIENT_ID
google.use-firebase-auth=false

# Google Play IAP Settings
google.play.package-name=com.fidforge.thefirst
google.play.vip-product-id=vip_month
daily-mineral=1000
vip.daily-mineral=10000
vip.mineral-reward-multiplier=4

# Zone Settings
zone.require-previous-stage-cleared=false

# Test Settings
test.guest-keep-data-on-logout=true
